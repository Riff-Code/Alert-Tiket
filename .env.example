# Token API Fonnte - dapatkan di dashboard Fonnte (https://fonnte.com)
FONNTE_TOKEN=isi_token_fonnte_di_sini

# Nomor WhatsApp engineer yang akan menerima notifikasi.
# Format: 62xxxxxxxxxx (tanpa + atau 0 di depan)
#
# Untuk 1 engineer:
# ENGINEER_WA=6281234567890
#
# Untuk multiple engineer, pisahkan dengan koma:
# ENGINEER_WA=6281234567890,6285567890123,6283212345678
ENGINEER_WA=6281234567890
